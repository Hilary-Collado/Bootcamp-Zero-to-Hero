boolean correoElectronicoValido(String s){
    int at = s.indexOf('@');
    int lastAt = s.lastIndexOf('@');
    int dot = s.indexOf('.', at + 1);
    int lastDot = s.lastIndexOf('.');
    
    return at > 0 && at == lastAt && dot > at + 1 && dot == lastDot && dot < s.length() - 1;
}
