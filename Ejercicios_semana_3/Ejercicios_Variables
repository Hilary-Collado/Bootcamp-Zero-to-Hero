double leycosenos(double a, double b, double gamma){
    double num1 = Math.pow(a, 2) + Math.pow(b, 2);
    double num2 = Math.cos(Math.toRadians(gamma));
    double c = Math.sqrt(num1 - 2 * a * b * num2);
    return c;
}
leycosenos(3.0, 4.0, 90.0);
leycosenos(11.0, 11.0, 60.0);


double promedio(double edadMenor, int edadMayor){
    var sumaEdades = edadMenor + edadMayor;
    var promedio = sumaEdades / 2;
    return promedio;
}
