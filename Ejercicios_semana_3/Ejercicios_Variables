double distancia(double x1, double y1, double x2, double y2){
    var punto1 = Math.pow((x2 - x1), 2.0);
    var punto2 = Math.pow((y2 - y1), 2.0);
    var d = Math.sqrt(punto1 + punto2);
    return d;
}
