double gravedadSuperficial(double masa, double r){
    double G = 6.674e-11;
    double radio = r * r;
    double gravedadSup = (G * masa) / radio;
    return gravedadSup;
}
gravedadSuperficial(5.972e24, 6.378e6);
gravedadSuperficial(6.421e23, 3.3972e6);


